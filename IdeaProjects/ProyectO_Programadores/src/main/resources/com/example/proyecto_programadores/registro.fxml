<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="450.0" styleClass="fondoBase" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_programadores.RegistroController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="66.0" fitWidth="59.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../images/icono agregar usuario.png" />
               </image>
               <HBox.margin>
                  <Insets left="50.0" />
               </HBox.margin>
            </ImageView>
            <Label prefHeight="100.0" prefWidth="245.0" text="Registro de Usuario">
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
               <font>
                  <Font name="System Bold" size="26.0" />
               </font></Label>
         </children>
      </HBox>
      <HBox prefHeight="324.0" prefWidth="450.0">
         <children>
            <VBox prefHeight="324.0" prefWidth="171.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Nombre de usuario:">
                           <font>
                              <Font size="17.0" />
                           </font></Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Contraseña:">
                           <font>
                              <Font size="17.0" />
                           </font></Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Género:">
                           <font>
                              <Font size="17.0" />
                           </font></Label>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <Label text="Lenguaje de programación:" wrapText="true">
                           <font>
                              <Font size="17.0" />
                           </font></Label>
                     </children>
                  </HBox>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin></VBox>
            <VBox prefHeight="324.0" prefWidth="253.0">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="txtNombreRegistro" prefHeight="40.0" prefWidth="235.0" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <TextField fx:id="txtPasswordRegistro" prefHeight="40.0" prefWidth="235.0" />
                     </children>
                  </HBox>
                  <HBox prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <VBox alignment="CENTER_LEFT" prefHeight="81.0" prefWidth="195.0">
                           <children>
                              <HBox prefHeight="100.0" prefWidth="200.0">
                                 <children>
                                    <RadioButton fx:id="rbHombre" mnemonicParsing="false" text="Hombre">
                                       <toggleGroup>
                                          <ToggleGroup fx:id="genero" />
                                       </toggleGroup>
                                       <font>
                                          <Font size="17.0" />
                                       </font></RadioButton>
                                 </children>
                              </HBox>
                              <HBox prefHeight="100.0" prefWidth="200.0">
                                 <children>
                                    <RadioButton fx:id="rbMujer" mnemonicParsing="false" text="Mujer" toggleGroup="$genero">
                                       <font>
                                          <Font size="17.0" />
                                       </font></RadioButton>
                                 </children>
                              </HBox>
                              <HBox prefHeight="100.0" prefWidth="200.0">
                                 <children>
                                    <RadioButton fx:id="rbPrefieroNoDecirlo" mnemonicParsing="false" text="Prefiero no decirlo" toggleGroup="$genero">
                                       <font>
                                          <Font size="17.0" />
                                       </font></RadioButton>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0">
                     <children>
                        <ComboBox fx:id="cbLenguajeRegistro" prefHeight="34.0" prefWidth="235.0" />
                     </children>
                  </HBox>
               </children></VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="186.0">
               <children>
                  <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#onRegistrarBotonClick" prefHeight="43.0" prefWidth="152.0" styleClass="botonAzul" text="Registrar">
                     <graphic>
                        <ImageView fitHeight="35.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../images/icono agregar usuario.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
            </VBox>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="186.0">
               <children>
                  <Button fx:id="btnIrLogin" mnemonicParsing="false" onAction="#onVolverAlLoginBotonClick" prefHeight="43.0" prefWidth="152.0" styleClass="botonGris" text="Volver al Login">
                     <graphic>
                        <ImageView fitHeight="36.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../images/icono flecha izquierda.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
            </VBox>
         </children></HBox>
   </children>
</VBox>
