<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ejerciciosclase2_parte1.HelloController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="600.0">
         <children>
            <HBox alignment="CENTER" prefHeight="79.0" prefWidth="600.0">
               <children>
                  <Label id="titulo" alignment="TOP_CENTER" styleClass="titulo" text="PAÍSES" textAlignment="CENTER" />
               </children></HBox>
            <HBox prefHeight="145.0" prefWidth="500.0">
               <children>
                  <ComboBox fx:id="comboBox" onAction="#onRellenarTextArea" prefHeight="25.0" prefWidth="217.0" styleClass="comboBox">
                     <HBox.margin>
                        <Insets left="50.0" top="20.0" />
                     </HBox.margin>
                  </ComboBox>
               </children>
            </HBox>
            <HBox alignment="TOP_CENTER" prefHeight="159.0" prefWidth="600.0">
               <children>
                  <TextArea fx:id="textArea" prefHeight="206.0" prefWidth="350.0" styleClass="textArea" />
               </children>
            </HBox>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="botonAtras" mnemonicParsing="false" onAction="#cambiarVentana" styleClass="botonGuardar" text="Atrás" />
               </children>
               <padding>
                  <Insets left="20.0" top="20.0" />
               </padding>
            </HBox>
         </children></VBox>
   </children>
</AnchorPane>
