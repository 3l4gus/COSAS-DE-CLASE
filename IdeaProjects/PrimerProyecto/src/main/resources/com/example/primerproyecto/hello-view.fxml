<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.primerproyecto.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" prefHeight="17.0" prefWidth="60.0" text="3l4gu" textOverrun="WORD_ELLIPSIS" />
    <Button onAction="#onHelloButtonClick" prefHeight="14.0" prefWidth="47.0" text="Hello!" />
   <Button mnemonicParsing="false" onAction="#onHolaMundoBottonClick" text="Hola mundo" />
   <Label fx:id="textoNombre" prefHeight="17.0" prefWidth="64.0" text="Olivera" />
</VBox>
