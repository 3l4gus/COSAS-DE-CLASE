<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="300.0" prefWidth="600.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_programadores.EditarPerfilController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="300.0" prefWidth="187.0">
         <children>
            <ImageView fitHeight="112.0" fitWidth="81.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../images/icono editar.png" />
               </image>
            </ImageView>
            <ImageView fitHeight="131.0" fitWidth="115.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../images/icono engranajes.png" />
               </image>
            </ImageView>
         </children>
         <HBox.margin>
            <Insets top="30.0" />
         </HBox.margin></VBox>
      <VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="467.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="209.0" prefWidth="454.0">
               <children>
                  <Label text="Editar perfil">
                     <font>
                        <Font name="System Bold" size="25.0" />
                     </font></Label>
               </children>
            </HBox>
            <HBox prefHeight="314.0" prefWidth="454.0">
               <children>
                  <VBox prefHeight="179.0" prefWidth="223.0">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Label text="Nombre de usuario:">
                                 <font>
                                    <Font size="14.0" />
                                 </font></Label>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Label text="Contraseña:">
                                 <font>
                                    <Font size="14.0" />
                                 </font></Label>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <Label text="Género:">
                                 <font>
                                    <Font size="14.0" />
                                 </font></Label>
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="0.0">
                           <children>
                              <Label prefHeight="20.0" prefWidth="208.0" text="Lenguaje de programación:">
                                 <font>
                                    <Font size="14.0" />
                                 </font></Label>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <VBox prefHeight="100.0" prefWidth="300.0">
                     <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <TextField fx:id="txtNombre" />
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <TextField fx:id="txtPassword" />
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                              <RadioButton fx:id="rbHombre" mnemonicParsing="false" text="Hombre">
                                 <toggleGroup>
                                    <ToggleGroup fx:id="genero" />
                                 </toggleGroup></RadioButton>
                              <RadioButton fx:id="rbMujer" mnemonicParsing="false" text="Mujer" toggleGroup="$genero" />
                              <RadioButton fx:id="rbPrefieroNoDecirlo" mnemonicParsing="false" text="Prefiero no decirlo" toggleGroup="$genero" />
                           </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <ComboBox fx:id="cbLenguaje" prefHeight="25.0" prefWidth="177.0" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets left="20.0" />
               </VBox.margin>
            </HBox>
            <HBox prefHeight="183.0" prefWidth="454.0">
               <children>
                  <VBox alignment="CENTER_RIGHT" prefHeight="35.0" prefWidth="436.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onGuardarCambiosClick" prefHeight="10.0" prefWidth="171.0" styleClass="botonAzul" text="Guardar cambios">
                           <graphic>
                              <ImageView fitHeight="21.0" fitWidth="17.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../images/icono guardar.png" />
                                 </image>
                              </ImageView>
                           </graphic></Button>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="245.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onCancelarClick" prefHeight="35.0" prefWidth="120.0" styleClass="botonGris" text="Cancelar">
                           <graphic>
                              <ImageView fitHeight="26.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../../../images/icono X.png" />
                                 </image>
                              </ImageView>
                           </graphic></Button>
                     </children>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets right="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
