<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="480.0" stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_programadores.InicioController">
   <children>
      <HBox prefHeight="65.0" prefWidth="480.0" styleClass="fondoAzul">
         <children>
            <ImageView fitHeight="65.0" fitWidth="65.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../images/icono etiqueta.png" />
               </image>
               <HBox.margin>
                  <Insets left="30.0" />
               </HBox.margin>
            </ImageView>
            <VBox alignment="CENTER_LEFT" prefHeight="65.0" prefWidth="446.0">
               <children>
                  <Label fx:id="lblBienvenida" prefHeight="53.0" prefWidth="154.0" text="¡Bienvenido/a!" textFill="WHITE" wrapText="true">
                     <font>
                        <Font name="System Bold" size="17.0" />
                     </font></Label>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </VBox>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="360.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onCerrarSesionClick" prefHeight="32.0" prefWidth="135.0" styleClass="botonAzul" text="Cerrar sesión">
                     <graphic>
                        <ImageView fitHeight="25.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../images/icono salir.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
               <HBox.margin>
                  <Insets right="20.0" />
               </HBox.margin>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="37.0" prefWidth="480.0" styleClass="fondoBase">
         <children>
            <VBox alignment="CENTER" prefHeight="37.0" prefWidth="142.0">
               <children>
                  <Label prefHeight="25.0" prefWidth="158.0" text="Filtrar por lenguaje:">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Label>
               </children>
               <padding>
                  <Insets left="20.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER" prefHeight="100.0" prefWidth="129.0">
               <children>
                  <ComboBox fx:id="cbFiltro" prefHeight="23.0" prefWidth="180.0" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox prefHeight="300.0" prefWidth="480.0" styleClass="fondoBase">
         <children>
            <TableView styleClass="bordesRedondos" fx:id="tablaProgramadores" prefHeight="152.0" prefWidth="480.0">
              <columns>
                <TableColumn fx:id="colUsuario" prefWidth="75.0" text="Usuario" />
                <TableColumn fx:id="colGenero" prefWidth="75.0" text="Género" />
                  <TableColumn fx:id="colLenguaje" prefWidth="81.0" text="Lenguaje" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <HBox.margin>
                  <Insets left="20.0" right="20.0" />
               </HBox.margin>
            </TableView>
         </children>
      </HBox>
      <HBox prefHeight="78.0" prefWidth="480.0" styleClass="fondoBase">
         <children>
            <VBox alignment="CENTER" prefHeight="78.0" prefWidth="152.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onEditarPerfilClick" prefHeight="32.0" prefWidth="134.0" styleClass="botonAzul" text="Editar perfil">
                     <graphic>
                        <ImageView fitHeight="23.0" fitWidth="19.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../images/icono editar.png" />
                           </image>
                        </ImageView>
                     </graphic></Button>
               </children>
               <HBox.margin>
                  <Insets left="20.0" />
               </HBox.margin>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="73.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onExcelClick" prefHeight="37.0" prefWidth="64.0" styleClass="botonAzul" text="Excel" />
               </children>
            </VBox>
            <VBox alignment="CENTER_LEFT" prefHeight="78.0" prefWidth="82.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#onPdfClick" prefHeight="37.0" prefWidth="64.0" styleClass="botonAzul" text="PDF" />
               </children>
            </VBox>
            <ImageView fitHeight="72.0" fitWidth="66.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../images/icono ordenador.png" />
               </image>
               <HBox.margin>
                  <Insets left="50.0" top="5.0" />
               </HBox.margin>
            </ImageView>
         </children>
      </HBox>
   </children>
</VBox>
