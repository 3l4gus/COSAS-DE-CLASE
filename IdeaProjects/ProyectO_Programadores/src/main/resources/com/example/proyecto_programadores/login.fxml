<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@estilos.css" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="550.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyecto_programadores.LoginController">
    <children>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
            <children>
            <ImageView fitHeight="112.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/icono etiqueta.png" />
                </image>
               <HBox.margin>
                  <Insets right="50.0" />
               </HBox.margin>
            </ImageView>
                <Label alignment="TOP_CENTER" contentDisplay="CENTER" text="Comunidad de Programadores" />
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label text="Usuario:" />
                            </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <Label text="Contraseña:" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <TextField fx:id="txtUsuarioLogin" />
                            </children>
                        </HBox>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                            <children>
                                <TextField fx:id="txtPasswordLogin" />
                            </children>
                        </HBox>
                    </children></VBox>
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0">
            <children>
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onLoginBotonClick" prefHeight="49.0" prefWidth="160.0" text="Login">
                     <graphic>
                        <ImageView fitHeight="32.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/icono entrar.png" />
                            </image>
                        </ImageView>
                     </graphic></Button>
                    </children>
                </VBox>
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onRegistrarseBotonClick" prefHeight="49.0" prefWidth="111.0" text="Registrarse">
                     <graphic>
                        <ImageView fitHeight="37.0" fitWidth="33.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../../images/icono agregar usuario.png" />
                            </image>
                        </ImageView>
                     </graphic></Button>
                    </children>
                </VBox>
            </children>
        </HBox>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <ImageView fitHeight="111.0" fitWidth="111.0" pickOnBounds="true" preserveRatio="true">
                <image>
                    <Image url="@../../../images/icono ordenador.png" />
                </image>
            </ImageView>
         </children>
      </HBox>
    </children>
</VBox>
