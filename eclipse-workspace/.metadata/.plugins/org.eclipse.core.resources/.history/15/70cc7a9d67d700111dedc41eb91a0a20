package ejercicios;

public class Ejercicio1 {
	public static void main(String[] args) {
		Runnable tarea = new Runnable() {
			public void run() {
				for(int i = 1; i < 6; i++) {
					System.out.println("Mensaje " + i + ": cositas.." + Thread.currentThread().getName());
				}
			}
		};
		
		Thread hilo1 = new Thread(tarea, "Manuel");
		Thread hilo2 = new Thread(tarea, "Paola");
		Thread hilo3 = new Thread(tarea, "César");
		hilo1.start();
		hilo2.start();
		hilo3.start();
	}

}
